# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Confidence Engine data sources
# football-data.org: free tier, sign up at football-data.org for a token
FOOTBALL_DATA_API_KEY=your_football_data_org_token
# Gemini: used only to phrase the reason text, never to generate the score
# itself -- see lib/services/confidenceEngine.ts. Get a free-tier key at
# aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key

# ZenRows: proxy/anti-bot fetch service, used for sites that block plain
# server-side fetch() (predictz.com, forebet.com). Sign up at zenrows.com,
# free tier is 1,000 credits, no card required.
ZENROWS_API_KEY=your_zenrows_api_key

# Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/BetsMeterBot
# Verifies incoming webhook requests actually come from Telegram (sent back
# as the X-Telegram-Bot-Api-Secret-Token header). Generate any random
# string, then register it with setWebhook (see README) -- see the webhook
# route's isAuthorized() for the same soft-fail-if-unset pattern as CRON_SECRET.
TELEGRAM_WEBHOOK_SECRET=your_random_secret_string

# Per-platform credentials, added as Decode/Encode services are built.
# SPORTYBET_API_KEY=
# BET9JA_API_KEY=
# ONEXBET_API_KEY=
# BETKING_API_KEY=

# Secures /api/cron/predictor so it can't be triggered by anyone who finds
# the URL. Vercel automatically sends this as a Bearer token on scheduled
# cron invocations once set -- generate any random string for this value.
CRON_SECRET=your_random_secret_string

# Support contact shown on site
NEXT_PUBLIC_SUPPORT_EMAIL=support@betmeter.com

# Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# API-Football (api-sports.io) -- wide league coverage incl. international.
# Used first by the team matcher; football-data.org stays as fallback.
API_FOOTBALL_KEY=

# OddsPapi (oddspapi.io) -- powers the Odds Comparison page (odds from hundreds of bookmakers).
# Without it the page shows 'not set up yet'.
ODDSPAPI_API_KEY=
