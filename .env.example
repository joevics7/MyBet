# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Sports stats provider (Confidence Engine + Fixture/Results Feed)
# e.g. API-Football — see product spec, budget $19+/month minimum
SPORTS_STATS_API_KEY=your_sports_stats_api_key
SPORTS_STATS_API_BASE_URL=https://your-provider.example.com

# Telegram bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
NEXT_PUBLIC_TELEGRAM_BOT_URL=https://t.me/betmeter_bot

# Per-platform credentials, added as Decode/Encode services are built.
# SPORTYBET_API_KEY=
